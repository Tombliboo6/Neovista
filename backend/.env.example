# ============================================
# NeoVista 环境变量配置示例
# ============================================

# 管理员密钥（必填）
ADMIN_SECRET_KEY=your-secret-key-here-change-in-production

# 登录验证码邮件（必填，需使用已在 Resend 验证过的发件邮箱）
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@your-domain.com

# CORS 允许的源（生产环境必改）
# 开发环境：http://localhost:5173
# 生产环境：https://neotest.site,https://www.neotest.site
CORS_ALLOW_ORIGINS=http://localhost:5173

# 数据库连接（可选，默认 SQLite）
# 开发环境（默认）：sqlite:///./neovista.db
# 生产环境（推荐）：sqlite:////var/lib/neovista/neovista.db
# PostgreSQL：postgresql://user:password@localhost/neovista
# MySQL：mysql://user:password@localhost/neovista
DATABASE_URL=sqlite:///./neovista.db

# ============================================
# 账单与限流配置（可选，未配置时使用默认值）
# ============================================
CREDITS_PER_YUAN=100
WELCOME_CREDITS=200
REGISTER_IP_DAILY_LIMIT=3
SEND_CODE_IP_HOURLY_LIMIT=10
FREE_CHAT_DAILY_LIMIT=30
FREE_AGENT_CHAT_DAILY_LIMIT=5

# ============================================
# API 渠道配置（必填，至少配置一个）
# ============================================
API_CHANNEL_1_NAME=Amutes
API_CHANNEL_1_BASE_URL=https://www.amutes.com
API_CHANNEL_1_API_KEY=your-api-key-here
API_CHANNEL_1_MODEL=gemini-3.1-flash-image-preview

# 可选：第二个渠道
# API_CHANNEL_2_NAME=COMFLY Image
# API_CHANNEL_2_BASE_URL=https://ai.comfly.chat
# API_CHANNEL_2_API_KEY=your-backup-key
# API_CHANNEL_2_MODEL=gemini-3.1-flash-image-preview

# ============================================
# DeepSeek 配置（可选，作为降级）
# ============================================
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# Chat 渠道配置（Flash/Pro）
# ============================================
CHAT_FLASH_CHANNEL_1_NAME=Amutes Chat
CHAT_FLASH_CHANNEL_1_BASE_URL=https://www.amutes.com
CHAT_FLASH_CHANNEL_1_API_KEY=your-flash-key
CHAT_FLASH_CHANNEL_1_MODEL=gemini-3.1-flash-lite-preview

CHAT_FLASH_CHANNEL_2_NAME=COMFLY Chat
CHAT_FLASH_CHANNEL_2_BASE_URL=https://ai.comfly.chat
CHAT_FLASH_CHANNEL_2_API_KEY=your-second-flash-key
CHAT_FLASH_CHANNEL_2_MODEL=gemini-3.1-flash-lite-preview

CHAT_PRO_CHANNEL_1_NAME=COMFLY Chat Pro
CHAT_PRO_CHANNEL_1_BASE_URL=https://ai.comfly.chat
CHAT_PRO_CHANNEL_1_API_KEY=your-pro-key
CHAT_PRO_CHANNEL_1_MODEL=gemini-3.1-pro-preview

CHAT_PRO_CHANNEL_2_NAME=Amutes Chat Pro
CHAT_PRO_CHANNEL_2_BASE_URL=https://www.amutes.com
CHAT_PRO_CHANNEL_2_API_KEY=your-second-pro-key
CHAT_PRO_CHANNEL_2_MODEL=gemini-3.1-pro-preview
