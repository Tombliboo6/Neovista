# ============================================
# NeoVista 环境变量配置示例
# ============================================

# 管理员密钥（必填）
ADMIN_SECRET_KEY=your-secret-key-here-change-in-production

# CORS 允许的源（生产环境必改）
# 开发环境：http://localhost:5173
# 生产环境：https://neotest.site,https://www.neotest.site
CORS_ALLOW_ORIGINS=http://localhost:5173

# 数据库连接（可选，默认 SQLite）
# 开发环境（默认）：sqlite:///./neovista.db
# 生产环境（推荐）：sqlite:////var/lib/neovista/neovista.db
# PostgreSQL：postgresql://user:password@localhost/neovista
# MySQL：mysql://user:password@localhost/neovista
DATABASE_URL=sqlite:///./neovista.db

# ============================================
# API 渠道配置（必填，至少配置一个）
# ============================================
API_CHANNEL_1_NAME=Amutes
API_CHANNEL_1_BASE_URL=https://api.amutes.ai/v1
API_CHANNEL_1_API_KEY=your-api-key-here
API_CHANNEL_1_MODEL=gemini-3.1-flash-image-preview

# 可选：第二个渠道
# API_CHANNEL_2_NAME=Backup
# API_CHANNEL_2_BASE_URL=https://backup-api.example.com/v1
# API_CHANNEL_2_API_KEY=your-backup-key
# API_CHANNEL_2_MODEL=gemini-3.1-flash-image-preview

# ============================================
# DeepSeek 配置（可选，作为降级）
# ============================================
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============================================
# Chat 渠道配置（Flash/Pro）
# ============================================
CHAT_FLASH_CHANNEL_1_NAME=Flash1
CHAT_FLASH_CHANNEL_1_BASE_URL=https://api.amutes.ai/v1
CHAT_FLASH_CHANNEL_1_API_KEY=your-flash-key
CHAT_FLASH_CHANNEL_1_MODEL=gemini-2.0-flash-exp

CHAT_PRO_CHANNEL_1_NAME=Pro1
CHAT_PRO_CHANNEL_1_BASE_URL=https://api.amutes.ai/v1
CHAT_PRO_CHANNEL_1_API_KEY=your-pro-key
CHAT_PRO_CHANNEL_1_MODEL=gemini-2.0-pro-exp
