[Unit]
Description=NeoVista FastAPI Backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/neovista/backend
EnvironmentFile=/var/www/neovista/backend/.env
Environment="PATH=/var/www/neovista/backend/.venv/bin"
ExecStart=/var/www/neovista/backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
